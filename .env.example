# Copy to .env and fill in. Never commit .env.

# --- OCR provider ---
# "azure" or "paddle". If empty, Azure is used when endpoint+key are set, otherwise PaddleOCR.
OCR_PROVIDER=

# --- Azure Computer Vision (Read API) ---
AZURE_OCR_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OCR_KEY=<your-azure-key>
AZURE_OCR_REGION=<your-azure-region>
AZURE_OCR_POLL_INTERVAL=1
AZURE_OCR_MAX_POLLS=15

# --- OpenAI (optional: LLM correction of drug names) ---
OPENAI_API_KEY=<your-openai-key>
OPENAI_MODEL=gpt-4-turbo

# --- Misc ---
# Set to 1 to skip loading PaddleOCR (used by tests)
SKIP_PADDLE_OCR_INIT=0
LOG_LEVEL=INFO
PORT=8000
